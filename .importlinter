[importlinter]
root_packages =
    app
    desktop
include_external_packages = True

[importlinter:contract:layers]
name = Layers call downward only
type = layers
layers =
    app.main
    app.lifespan
    app.api : app.ws
    app.modules
    app.common : app.integrations
    app.core

[importlinter:contract:core-is-independent]
name = core imports nothing above it
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.api
    app.ws
    app.modules
    app.integrations
    app.common

[importlinter:contract:sdk-only-in-integrations]
name = claude_agent_sdk only inside app.integrations.claude
type = forbidden
source_modules =
    app.api
    app.ws
    app.modules
    app.common
    app.core
    app.main
    app.lifespan
forbidden_modules =
    claude_agent_sdk
allow_indirect_imports = True

[importlinter:contract:desktop-is-a-client]
name = desktop talks to the backend over the WebSocket only
type = forbidden
source_modules =
    desktop
forbidden_modules =
    app
