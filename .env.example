DEBUG=true
LOG_LEVEL=

JARVIS_VAULT_DIR=~/jarvis-vault
JARVIS_STATE_FILE=data/state.json

BRAIN_MODEL=
BRAIN_EFFORT=
BRAIN_SKILLS=metrics,inbox,trends,plan,vault
BRAIN_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Skill
BRAIN_MAX_TURNS=100

VOICE_ENABLED=true
VOICE_LANGUAGES=uz,ru,en
VOICE_STT_MODEL=small
VOICE_STT_UZ_SOURCE=OvozifyLabs/whisper-small-uz-v1
VOICE_STT_UZ_DIR=data/models/whisper-small-uz
VOICE_WAKE_THRESHOLD=0.5

JARVIS_PORT=8765
